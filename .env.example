# Local/fork runtime
RPC_URL=http://127.0.0.1:8545
API_URL=http://localhost:4021
BASE_RPC_URL=https://mainnet.base.org
CHAIN_ID=31337

# Required for the judged Graph demo
SUBGRAPH_URL=https://api.studio.thegraph.com/query/REPLACE_ME/turing-pool/version/latest

# Optional LLM strategist. Without it, the documented deterministic policy runs.
ANTHROPIC_API_KEY=

# Execution safety
SLIPPAGE_BPS=50

# Production hosting only. Use the output from a real Base deployment, never a
# local or fork-only deployment. Prefer setting this in the host's secret store.
DEPLOYMENTS_JSON=
SERVER_DOMAIN=
BASE_URL=
