# Local/fork runtime
RPC_URL=http://127.0.0.1:8545
API_URL=http://localhost:4021
BASE_RPC_URL=https://mainnet.base.org
CHAIN_ID=31337

# Optional legacy Graph endpoint. The live demo uses Nuthatch when NUTHATCH_URL
# is configured, then safely falls back to direct chain-event reads.
SUBGRAPH_URL=https://api.studio.thegraph.com/query/REPLACE_ME/turing-pool/version/latest
NUTHATCH_URL=http://127.0.0.1:8288

# Optional override used by `pnpm nuthatch:dev`. A private World RPC is more
# reliable than the checked-in public fallback.
NUTHATCH_RPC_URL=

# Optional LLM strategist. Without it, the documented deterministic policy runs.
ANTHROPIC_API_KEY=

# Execution safety
SLIPPAGE_BPS=50

# Production hosting only. Use the output from a real chain deployment, never a
# local or fork-only deployment. Prefer setting this in the host's secret store.
DEPLOYMENTS_JSON=
SERVER_DOMAIN=
BASE_URL=

# Optional Vercel fallback. The production World Chain deployment does not set
# this; it exists only for an explicitly non-executable hosted snapshot.
HOSTED_DEMO_MODE=

# Public interactive demo. Keep these server-side; only use disposable demo
# accounts and cap the amount accepted by POST /demo/trade.
DEMO_TRADES_ENABLED=
DEMO_TRADE_ORIGIN=
DEMO_TRADE_MAX_AMOUNT_IN=1000000000000000000
BOT_PRIVATE_KEY=
HUMAN_AGENT_PRIVATE_KEY=
