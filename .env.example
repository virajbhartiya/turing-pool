# World Chain runtime
RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
API_URL=http://localhost:4021
CHAIN_ID=480

# AgentKit signs and execution settles on World Chain.
AGENTKIT_SIGNER_CHAIN_ID=480
AGENTKIT_SIGNER_RPC_URL=

# Canonical identity source.
WORLD_RPC_URL=

# Optional legacy Subgraph status endpoint. Autopilot does not use this as a
# decision source; the World Chain demo uses Nuthatch SQL + MCP.
SUBGRAPH_URL=https://api.studio.thegraph.com/query/REPLACE_ME/turing-pool/version/latest
NUTHATCH_URL=http://127.0.0.1:8288

# Optional override used by `pnpm nuthatch:dev`. A private World RPC is more
# reliable than the checked-in public fallback.
NUTHATCH_RPC_URL=

# Reserved for an optional narrative model. Execution decisions remain bounded
# and reproducible without an external model.
ANTHROPIC_API_KEY=

# Execution safety
SLIPPAGE_BPS=50

# Optional permissionless LP deployment. Set this to the verified
# TuringPoolVaultFactory address to enable vault discovery, creation, deposits,
# withdrawals, and connected-wallet SwapVM trades in the terminal.
VAULT_FACTORY=

# Optional inventory-backed faucet for connected-wallet test asset claims.
FAUCET_ADDRESS=

# Production hosting only. Use the output from a real chain deployment, never a
# local or fork-only deployment. Prefer setting this in the host's secret store.
DEPLOYMENTS_JSON=
SERVER_DOMAIN=
BASE_URL=

# Optional server-operated market actors. Keep keys server-side and cap input.
MARKET_TRADES_ENABLED=
MARKET_TRADE_ORIGIN=
MARKET_TRADE_MAX_AMOUNT_IN=1000000000000000000
BOT_PRIVATE_KEY=
HUMAN_AGENT_PRIVATE_KEY=
